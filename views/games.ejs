<html>
    <head>
        <title>Add a Game</title>
    </head>
    <body>
        <h2>Add a Game</h2>
        <form method="POST" action="/games">
            <label for="newGame">Game title:</label>
            <input id="newGame" type="text" name="newGame" required>
            <br>
            <input type="submit" value="Submit">
        </form>
    </body>
</html>